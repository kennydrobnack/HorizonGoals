{
  "name": "horizongoals",
  "productName": "HorizonGoals",
  "version": "2.0.0",
  "description": "Count down to a goal: a menu bar (macOS) / system tray (Windows) and wallpaper countdown to your goal",
  "main": "src/main.js",
  "license": "CC0-1.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "electron-packager . HorizonGoals --platform=darwin --arch=arm64 --out=dist --overwrite --prune=true --ignore='^/(dist|test|build|scripts|README.md|\\.gitignore)' --app-bundle-id=com.horizongoals.app",
    "build:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.horizongoals.app",
    "productName": "HorizonGoals",
    "copyright": "CC0-1.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "ui/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.exe"
    }
  }
}
